# ===========================================
# Drive Tracker - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.template .env

# -------------------------------------------
# Google Maps API
# -------------------------------------------
# Required for map visualization
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API=your_google_maps_api_key_here

# -------------------------------------------
# MongoDB Database
# -------------------------------------------
# Connection string for MongoDB

# Atlas: mongodb+srv://user:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# -------------------------------------------
# Authentication (NextAuth.js)
# -------------------------------------------
# Secret for JWT token signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_secret_key_here_min_32_characters

# Base URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# -------------------------------------------
# Optional: Legacy JWT Secret (if needed)
# -------------------------------------------
JWT_SECRET=your_jwt_secret_here
